{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh",
            "timeout": 10,
            "statusMessage": "Checking the command against the project's rules"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-push.sh",
            "if": "Bash(git *)",
            "timeout": 20,
            "statusMessage": "Checking unpushed commits for session links"
          }
        ]
      }
    ]
  }
}
